#!/usr/bin/env bash
set -euo pipefail

RUNNER="/home/daniel/bin/n8n-chatbot-deploy-runner"
ORIGINAL="${RUNNER}.original"
COMMAND="${SSH_ORIGINAL_COMMAND:-}"

if [ ! -x "$ORIGINAL" ]; then
  printf 'error=original_runner_missing\n' >&2
  exit 70
fi

if [ "$COMMAND" = "diagnose" ]; then
  SSH_ORIGINAL_COMMAND="$COMMAND" exec "$ORIGINAL"

elif [ "$COMMAND" = "test" ]; then
  exec docker exec n8n-chatbot-1 node --test /app/src/runtimeCompilerBeta.test.js /app/src/workflowCreatePayload.test.js /app/src/planSpecSanitizer.test.js /app/src/plannerContextRedaction.test.js /app/src/conversationState.test.js /app/src/credentialResolutionAdapter.test.js /app/src/conversationController.test.js /app/src/conversationDeps.test.js /app/src/conversationEvidence.test.js /app/src/chatZoom.test.js /app/src/nodewisePlanner.test.js /app/src/nodewisePlannerPrompt.test.js /app/src/refinementDelta.test.js /app/src/requestClassification.test.js

elif [ "$COMMAND" = "conversation-report" ]; then
  exec docker exec n8n-chatbot-1 node /app/src/conversationEvidenceReport.js

elif printf '%s\n' "$COMMAND" | grep -Eq '^deploy [0-9a-fA-F]{7,40}$'; then
  SSH_ORIGINAL_COMMAND="$COMMAND" exec "$ORIGINAL"

else
  printf 'error=command_not_allowed\n' >&2
  exit 64
fi
