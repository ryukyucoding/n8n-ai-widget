# Local widget + self-hosted n8n (run_local.mjs)
N8N_BASE_URL=http://localhost:5678
N8N_API_KEY=
CHAT_AGENT_URL=http://localhost:3001/agent/run

# Local creation via fine-tuned model (run_local_creation.mjs)
# Can also live in ../../../n8n_json_schema/.env
OPENAI_API_KEY=
OPENAI_MODEL=ft:gpt-4.1-2025-04-14:widm:s1-original-desc-41:DmUZN4iU
CREATE_MAX_OUTPUT_TOKENS=16384
CREATE_MAX_CONTINUATIONS=2

# n8n Cloud AI Builder (run_cloud.mjs)
N8N_CLOUD_URL=https://widmn8n.app.n8n.cloud
N8N_CLOUD_API_KEY=
N8N_CLOUD_EMAIL=
N8N_CLOUD_PASSWORD=

# Source eval package (prepare_dataset.py)
N8N_EVAL_PACKAGE=/Users/angelicawang/Documents/n8n/n8n_json_schema/n8n_workflow_generator_package

# Playwright
PLAYWRIGHT_STORAGE_STATE=playwright/.auth/storageState.json

# Wait up to N ms for AI Builder edits to persist before scoring
PERSIST_TIMEOUT_MS=90000

# Keep imported workflows after each case (for manual inspection, e.g. credential prompts).
# Set to 0 or pass --no-keep-workflow on the CLI to restore auto-delete.
BENCHMARK_KEEP_WORKFLOW=1

# Auto-click Later on AI Builder post-build setup wizard (credentials / Execute step).
# n8n has no global "disable verification" — this avoids 5min timeouts during benchmark runs.
BENCHMARK_SKIP_SETUP=1
