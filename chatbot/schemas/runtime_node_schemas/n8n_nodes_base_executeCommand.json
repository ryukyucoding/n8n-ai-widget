{
  "displayName": "Execute Command",
  "name": "n8n-nodes-base.executeCommand",
  "icon": "node:execute-command",
  "iconColor": "crimson",
  "group": [
    "transform"
  ],
  "version": 1,
  "description": "Executes a command on the host",
  "defaults": {
