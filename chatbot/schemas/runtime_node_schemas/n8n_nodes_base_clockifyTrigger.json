{
  "displayName": "Clockify Trigger",
  "icon": {
    "light": "file:clockify.svg",
    "dark": "file:clockify.dark.svg"
  },
  "name": "n8n-nodes-base.clockifyTrigger",
  "group": [
    "trigger"
  ],
  "version": 1,
  "description": "Listens to Clockify events",
  "defaults": {
    "name": "Clockify Trigger"
  },
  "inputs": [],
  "outputs": [
    "main"
  ],
  "credentials": [
    {
      "name": "clockifyApi",
      "required": true
    }
  ],
  "polling": true,
  "properties": [
    {
      "displayName": "Workspace Name or ID",
      "name": "workspaceId",
      "type": "options",
      "description": "Choose from the list, or specify an ID using an <a href=\"https://docs.n8n.io/code/expressions/\">expression</a>",
      "typeOptions": {
        "loadOptionsMethod": "listWorkspaces"
      },
      "required": true,
      "default": ""
    },
    {
      "displayName": "Trigger",
      "name": "watchField",
      "type": "options",
      "options": [
        {
          "name": "New Time Entry",
          "value": 0
        }
      ],
      "required": true,
      "default": 0
    }
  ],
  "typeVersion": 1
}