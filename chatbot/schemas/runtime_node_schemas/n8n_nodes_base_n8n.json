      "displayOptions": {
        "show": {
          "resource": [
            "execution"
          ],
          "operation": [
            "getAll"
          ],
          "returnAll": [
            false
          ]
        }
      },
      "routing": {
        "request": {
          "qs": {
            "limit": "={{ $value }}"
          }
        }
      },
      "description": "Max number of results to return"
    },
    {
