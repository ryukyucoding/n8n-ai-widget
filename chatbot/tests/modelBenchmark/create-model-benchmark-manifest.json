      "acceptanceContract": {
        "contractRevision": 1,
        "expectedDeliveryState": "ready-to-run",
        "executionAssertions": [
          { "path": "name", "required": true, "expectedType": "string" },
          { "path": "email", "required": true, "expectedType": "string" },
          { "path": "total_todos", "required": true, "expectedType": "number", "equals": 20 },
