{
  "schemaVersion": "1.0",
  "benchmarkId": "create-candidate-quality-v1",
  "operation": "create",
  "plannerComparison": {
    "included": false,
    "reason": "First-round comparison isolates Create candidate quality."
  },
  "candidateModelSlots": [
    "candidate_a",
    "candidate_b",
    "candidate_c"
  ],
  "reproducibility": {
    "promptTemplateId": "create-candidate-v1",
    "promptTemplateFingerprintRequired": true,
    "runtimeSchemaSnapshotPath": "chatbot/schemas/runtime_node_schemas.json",
    "runtimeSchemaSnapshotFingerprintRequired": true,
    "decodingProfileId": "fixed-create-benchmark-v1",
    "decodingProfileFingerprintRequired": true,
    "perCaseMinimumRepetitions": 5,
    "perAttemptTimeoutMs": 120000,
    "randomization": "shuffle model-case-attempt order with a recorded non-sensitive run seed"
  },
  "attemptRecord": {
    "requiredFields": [
      "runId",
      "caseId",
      "modelSlot",
      "attemptIndex",
      "startedAt",
      "elapsedMs",
      "outcome",
      "failureStage",
      "jsonParseStatus",
      "runtimeSchemaStatus",
      "connectionPortStatus",
      "mustExecuteBeforeStatus",
      "semanticReviewStatus",
      "executionEvidenceStatus"
    ],
    "outcomeValues": [
      "completed",
      "timeout",
      "transport_failure",
      "invalid_output",
      "verification_failure"
    ],
    "failureStageValues": [
      "none",
      "generation",
      "json_parse",
      "runtime_schema",
      "connection_port",
      "must_execute_before",
      "semantic_review",
      "execution_assertion"
    ],
    "forbidFields": [
      "modelIdentifier",
      "modelHost",
      "endpoint",
      "authorization",
      "credential",
      "workflowId",
      "rawPrompt",
      "rawModelOutput",
      "workflowJson"
    ]
  },
  "metrics": [
    "generation_latency_ms",
    "timeout_rate",
    "json_parse_pass_rate",
    "runtime_schema_pass_rate",
    "connection_port_pass_rate",
    "must_execute_before_pass_rate",
    "semantic_review_pass_rate",
    "first_candidate_pass_rate",
    "repair_needed_rate",
    "candidate_count",
    "c01_safe_execution_assertion_pass_rate",
    "c04_c07_execution_evidence_status"
  ],
  "cases": [
