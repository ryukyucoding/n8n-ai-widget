# --- OpenAI Cloud Settings (For Intent Decomposer & Modify/Delete/Insert Agents) ---
OPENAI_API_KEY=sk-proj-your_real_openai_key_here
OPENAI_MODEL=gpt-4o
DECOMPOSER_MODEL=gpt-4o

# --- Ollama Local Settings (For Create/Generate workflow generation) ---
# OLLAMA_BASE_URL=http://140.115.54.63:11434/v1
# OLLAMA_BASIC_AUTH=Basic bmN1X3N0dWRlbnQ6d2lkbXdpZG0=
# OLLAMA_MODEL=qwen2.5-coder-32b-ft-original:latest
# OLLAMA_TEMPERATURE=0

# --- Model groups shown in the widget ---
# Create models use OLLAMA_BASE_URL above. Cloud edit models use OPENAI_BASE_URL/API.
CREATE_MODELS=qwen2.5-coder-32b-ft-original:latest
EDIT_MODELS=gpt-4o
# Ollama edit models are shown in the same Edit dropdown; selecting one routes
# insert/delete/modify calls to this OpenAI-compatible Ollama endpoint.
EDIT_OLLAMA_MODELS=gpt-oss:120b
# Edit-model Ollama server (gpt-oss), separate from Create-model server .63
EDIT_OLLAMA_BASE_URL=http://140.115.54.62:11434/v1
EDIT_OLLAMA_API_KEY=ollama-key
# EDIT_OLLAMA_BASIC_AUTH=Basic <base64-user-password>

# --- n8n Integration Settings ---
# n8n API key — generate in n8n Settings → API → Create API Key
N8N_API_KEY=your_n8n_api_key_here

# n8n base URL reachable from the chatbot container
# In docker-compose: http://n8n:5678
# For local dev without docker: http://localhost:5678
N8N_BASE_URL=http://n8n:5678

# Port for the chatbot server
PORT=3001

# The public facing URL of your n8n instance (used for generating links in the chat window)
N8N_PUBLIC_URL=https://widm-n8n.csie.ncu.edu.tw
