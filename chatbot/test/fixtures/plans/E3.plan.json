  "input": {
    "kind": "schedule",
    "itemSchema": {
      "site": "string",
      "statusCode": "number",
      "responseMs": "number"
    }
  },
  "trigger": {
    "name": "CP0 Mondays 07:30",
    "type": "n8n-nodes-base.scheduleTrigger",
    "typeVersion": 1.2,
    "parameters": {
      "rule": {
        "interval": [
          {
            "field": "cronExpression",
            "expression": "30 7 * * 1"
          }
        ]
      }
    },
    "expectCron": "30 7 * * 1"
  },
  "typedBindings": {
    "down": {
      "expr": "$json.statusCode >= 500 OR $json.responseMs > 2000",
      "operators": [
        "number:gte 500",
        "number:gt 2000"
      ],
      "combinator": "or"
    },
    "reason": {
      "expr": "$json.statusCode >= 500 ? \"error\" : \"slow\"",
      "type": "string",
      "note": "error wins when both hold"
    }
  },
  "checkpoints": [
    {
      "id": "CP1",
      "block": "keep down sites (status >= 500 OR responseMs > 2000)",
      "dependsOn": {
        "node": "@trigger",
        "port": 0
      },
      "node": {
        "name": "CP1 Site Is Down",
        "type": "n8n-nodes-base.filter",
        "typeVersion": 2.3,
        "parameters": {
          "conditions": {
            "options": {
              "caseSensitive": true,
              "leftValue": "",
              "typeValidation": "strict"
            },
            "conditions": [
              {
                "id": "e3-err",
                "leftValue": "={{ $json.statusCode }}",
                "rightValue": 500,
                "operator": {
                  "type": "number",
                  "operation": "gte"
                }
              },
              {
                "id": "e3-slow",
                "leftValue": "={{ $json.responseMs }}",
                "rightValue": 2000,
                "operator": {
                  "type": "number",
                  "operation": "gt"
                }
              }
            ],
            "combinator": "or"
          },
          "options": {}
        }
      },
      "contract": {
        "cardinality": "items",
        "fields": {
          "site": "string",
          "statusCode": "number",
          "responseMs": "number"
        }
      }
    },
    {
      "id": "CP2",
      "block": "exact projection site + reason",
      "dependsOn": {
        "node": "CP1 Site Is Down",
        "port": 0
      },
      "node": {
        "name": "CP2 Down Record",
        "type": "n8n-nodes-base.set",
        "typeVersion": 3.4,
        "parameters": {
          "assignments": {
            "assignments": [
              {
                "id": "e3-site",
                "name": "site",
                "type": "string",
                "value": "={{ $json.site }}"
              },
              {
                "id": "e3-reason",
                "name": "reason",
                "type": "string",
                "value": "={{ $json.statusCode >= 500 ? \"error\" : \"slow\" }}"
              }
            ]
          },
          "includeOtherFields": false,
          "options": {}
        }
      },
      "contract": {
        "cardinality": "items",
        "fields": {
          "site": "string",
          "reason": "string"
        }
      }
    }
  ],
  "outputBindings": {
    "down": {
      "node": "CP2 Down Record",
      "port": 0
    }
  },
